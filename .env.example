PORT=3000
DATABASE_PATH=./data/steam-roi.sqlite
STEAM_USER_AGENT=SteamCardROI/1.0 (contact: change-me@example.com)
CATALOG_URL=https://raw.githubusercontent.com/Austrum-lab/steam-appdb/master/data/all.json
STEAM_REQUESTS_PER_SECOND=1.5
STEAM_CATALOG_REQUESTS_PER_SECOND=0.25
STEAM_MARKET_REQUESTS_PER_SECOND=0.25
STEAM_MARKET_PRICE_DETAILS=false
STEAM_CONCURRENCY=3
CATALOG_SCAN_LIMIT=100
MARKET_SCAN_TTL_MINUTES=180
STORE_SCAN_TTL_MINUTES=60
METADATA_TTL_HOURS=168
AUTO_SCAN_INTERVAL_MINUTES=0
# Defina true somente se fornecer uma sessão válida; nenhuma credencial fica armazenada no código.
STEAM_MARKET_BUY_ORDERS=false
DEFAULT_PUBLISHER_FEE_BPS=1000
PUBLIC_BASE_URL=http://localhost:3000
# Segredo estável opcional para o cookie local de login assinado; gere um valor longo e aleatório.
AUTH_COOKIE_SECRET=
# Drops restantes exatos de uma conta autenticada (opcional; nunca cole cookies no chat ou no controle de versão).
STEAM_EXACT_DROPS=false
STEAM_SESSION_ID=
STEAM_LOGIN_SECURE=
